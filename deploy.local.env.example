# Copy to deploy.local.env and fill in values:
#   cp deploy/deploy.local.env.example deploy/deploy.local.env

DEPLOY_HOST=185.18.212.24
DEPLOY_PORT=22
DEPLOY_USER=root
# Leave empty when SSH key auth works (recommended on Windows — no sshpass).
# Optional override: DEPLOY_SSH_KEY=/path/to/private_key
DEPLOY_PASSWORD=

REMOTE_BACKEND_PATH=/var/www/daizima-backend
REMOTE_FRONTEND_PATH=/var/www/daizima-frontend

# Used when building frontend locally (on Windows/Git Bash use deploy-from-local.sh — it sets MSYS_NO_PATHCONV)
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_API_PROXY_TARGET=http://127.0.0.1:8100
NUXT_PUBLIC_SITE_URL=https://daizima.com
# Prefer admin host that proxies /ws/ (see deploy/WEBSOCKET_AND_CACHE.md)
NUXT_PUBLIC_WEBSOCKET_URL=wss://admin.daizima.com/ws
NUXT_PUBLIC_APP_NAME=Daizima
NUXT_PUBLIC_APP_ENV=production
NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Cloudflare (synced to remote backend .env on `./deploy/deploy-from-local.sh backend`)
# - Zone → DNS Edit: for ./deploy/ssl-issue-letsencrypt.sh
# - Zone → Cache Purge: product PDP purge after price/stock change
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_STOREFRONT_ORIGIN=https://daizima.com
